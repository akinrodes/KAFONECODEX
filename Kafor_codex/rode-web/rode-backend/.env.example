# ============================================
# RØDE Backend - Variables d'Environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS COMMITER LE FICHIER .env
# ============================================

# == APPLICATION ==
TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=

# == BASE DE DONNÉES (Développement Local Docker) ==
DB_CONNECTION=mysql
DB_HOST=rode-db
DB_PORT=3306
DB_DATABASE=rode_dev
DB_USER=rode_user
DB_PASSWORD=rodesecretpwd

# == LEMON SQUEEZY (Paiements & Abonnements) ==
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# == EMAIL (Resend) ==
RESEND_API_KEY=
EMAIL_FROM=no-reply@rode.io

# == SOCIAL AUTH (Optionnel) ==
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
